{
  "name": "notification-system",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,green \"tsx watch src/index.ts\" \"tsx watch src/start-worker.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/start-worker.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@bull-board/api": "^6.11.0",
    "@bull-board/fastify": "^6.11.0",
    "@fastify/static": "^10.1.5",
    "bullmq": "^5.52.0",
    "fastify": "^5.3.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.2"
  }
}
