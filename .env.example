# Copy file này thành .env rồi điền giá trị thật (.env được gitignore, không commit)

# --- EMAIL: mock (mặc định) | smtp | resend ---
EMAIL_MODE=mock
# smtp preset ethereal = SMTP thật zero-config (xem thư online, không vào inbox cá nhân)
# SMTP_PRESET=ethereal
# smtp host riêng = inbox thật (VD Gmail app password: myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop
EMAIL_FROM=Notification <you@gmail.com>

# --- SMS: mock (mặc định) | twilio (trial chỉ gửi tới số đã verify) ---
SMS_MODE=mock
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# --- Bảo mật + link hệ thống ---
# Ký HMAC payload webhook (header X-Notification-Signature: t=...,v1=...) — không set = không ký
WEBHOOK_SIGNING_SECRET=
# Secret riêng cho token link one-click unsubscribe (fallback: WEBHOOK_SIGNING_SECRET → API_KEY)
UNSUBSCRIBE_SECRET=
# URL gốc mà người nhận truy cập được — dùng dựng link {{unsubscribe_url}} trong nội dung
PUBLIC_BASE_URL=http://localhost:3000
